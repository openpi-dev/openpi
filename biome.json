{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "extensions/**/*.ts",
      "tests/**/*.ts",
      "extensions/**/*.cjs",
      ".github/actions/**/*.cjs",
      "benchmarks/**/*.ts",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "scripts/**/*.cjs",
      "scripts/**/*.ts",
      "web/ui/src/**/*.ts",
      "web/ui/src/**/*.tsx",
      "web/ui/*.json",
      "**/*.json",
      "!extensions/**/docs/**",
      "!docs/**",
      "!node_modules/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessStringRaw": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "off",
        "noUnsafeFinally": "off",
        "noUnsafeOptionalChaining": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "off",
        "useImportType": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noPrototypeBuiltins": "off",
        "noTemplateCurlyInString": "off",
        "noUselessEscapeInString": "off",
        "useBiomeIgnoreFolder": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
