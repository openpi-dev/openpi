{
  "manifest_version": 3,
  "name": "OpenPI Browser Bridge",
  "version": "0.1.0",
  "description": "Native browser navigation and X-Frame-Options support inside the local OpenPI workbench.",
  "minimum_chrome_version": "145",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["workbench.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
